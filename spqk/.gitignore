# Meson build directories
build/
builddir/
.build/

# Compiled object files
*.o
*.obj
*.so
*.dll
*.dylib
*.a
*.lib

# Meson subprojects: ignore downloaded/extracted sources,
# keep only the wrap files and any local patches
subprojects/*
!subprojects/*.wrap
!subprojects/packagefiles/

# IDE / editor files
.vs/
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace
compile_commands.json

# OS files
.DS_Store
Thumbs.db
._*
