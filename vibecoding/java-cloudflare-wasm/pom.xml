<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.example</groupId>
  <artifactId>java25-cloudflare-wasm</artifactId>
  <version>1.0.0</version>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <teavm.version>0.15.0</teavm.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-classlib</artifactId>
      <version>${teavm.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.0</version>
        <configuration>
          <release>${maven.compiler.release}</release>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.teavm</groupId>
        <artifactId>teavm-maven-plugin</artifactId>
        <version>${teavm.version}</version>
        <executions>
          <execution>
            <id>wasm-gc</id>
            <phase>process-classes</phase>
            <goals>
              <goal>compile</goal>
              <goal>copy-wasm-gc-runtime</goal>
            </goals>
            <configuration>
              <mainClass>com.example.Main</mainClass>
              <targetDirectory>${project.build.directory}/worker</targetDirectory>
              <targetFileName>app</targetFileName>
              <targetType>WEBASSEMBLY_GC</targetType>
              <optimizationLevel>FULL</optimizationLevel>
              <minifying>true</minifying>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
