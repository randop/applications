[server]
listen = "0.0.0.0:993"

[server.tls]
certificate = "/etc/imap/server.crt"
private_key = "/etc/imap/server.key"

[storage]
spool = "/var/spool/imap"
inbox = "/var/lib/imap"

[auth]
oauth_enabled = true

# TODO: replace with real values
[auth.workos]
issuer = "https://api.workos.com/user_management/client_xxx"
audience = ""
jwks_url = "https://api.workos.com/sso/jwks/client_xxx"

[limits]
max_command_bytes = 16384
# Maximum APPEND/literal message size: 5 MiB.
max_literal_bytes = 5242880
